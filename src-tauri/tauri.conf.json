{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "liCalendar",
  "mainBinaryName": "liCalendar",
  "version": "1.0.1",
  "identifier": "pro.softsoft.li-calendar",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "beforeBuildCommand": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "removeUnusedCommands": true
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "publisher": "softsoft.pro",
    "category": "Utility",
    "shortDescription": "松鼠日历",
    "longDescription": "松鼠日历",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}